<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.intco.warehouse.mapper.WarehouseMapper">
  <select id="selectWarehouseDaily" resultType="map">
    SELECT * FROM warehouse_daily_metric
    <if test="warehouseId != null">WHERE warehouse_id = #{warehouseId}</if>
    ORDER BY biz_date, warehouse_id
  </select>

  <select id="selectLatestZones" resultType="map">
    SELECT s.snapshot_date,s.warehouse_name,s.area_id,s.area_name,s.capacity_locations,
           s.occupied_locations,s.available_locations,s.occupancy_rate,s.material_type_count,
           s.abnormal_location_count,s.frozen_qty,s.area_owner,s.status
    FROM warehouse_area_snapshot s
    JOIN (
      SELECT warehouse_id, MAX(snapshot_date) max_date
      FROM warehouse_area_snapshot
      GROUP BY warehouse_id
    ) latest ON latest.warehouse_id = s.warehouse_id AND latest.max_date = s.snapshot_date
    <where><if test="warehouseId != null">s.warehouse_id = #{warehouseId}</if></where>
    ORDER BY s.warehouse_id, s.area_id
  </select>

  <select id="selectLatestZoneByArea" resultType="map">
    SELECT snapshot_date,warehouse_name,area_id,area_name,capacity_locations,occupied_locations,
           available_locations,occupancy_rate,material_type_count,abnormal_location_count,
           frozen_qty,area_owner,status
    FROM warehouse_area_snapshot
    WHERE area_id = #{areaId}
    ORDER BY snapshot_date DESC
    LIMIT 1
  </select>

  <select id="selectAlerts" resultType="map">
    SELECT * FROM exception_event
    <if test="warehouseId != null">WHERE warehouse_id = #{warehouseId}</if>
    ORDER BY event_time DESC
  </select>

  <select id="selectAlertsByArea" resultType="map">
    SELECT * FROM exception_event WHERE area_id = #{areaId} ORDER BY event_time DESC
  </select>

  <select id="selectTargets" resultType="map">
    SELECT * FROM kpi_target ORDER BY kpi_name
  </select>

  <select id="selectMeta" resultType="map">
    SELECT MIN(biz_date) start_date, MAX(biz_date) end_date,
           COUNT(DISTINCT biz_date) day_count
    FROM warehouse_daily_metric
    <if test="warehouseId != null">WHERE warehouse_id = #{warehouseId}</if>
  </select>

  <select id="selectInventory" resultType="map">
    SELECT * FROM inventory_snapshot
    WHERE warehouse_id = #{warehouseId}
    ORDER BY project_no, material_code
  </select>

  <select id="selectGroupedInventory" resultType="map">
    SELECT material_code,material_name,main_uom,MAX(specification) specification,
           SUM(on_hand_main_qty) on_hand,SUM(reserved_main_qty) reserved,
           SUM(frozen_main_qty) frozen,COUNT(DISTINCT project_no) projects,
           MAX(stock_date) stock_date
    FROM inventory_snapshot
    WHERE warehouse_id = #{warehouseId}
    GROUP BY material_code,material_name,main_uom
    ORDER BY material_code
  </select>

  <select id="selectDataCounts" resultType="map">
    SELECT
      (SELECT COUNT(*) FROM inventory_snapshot) inventorySnapshots,
      (SELECT COUNT(*) FROM sku_daily_metric) skuDailyMetrics,
      (SELECT COUNT(*) FROM warehouse_daily_metric) warehouseDailyMetrics,
      (SELECT COUNT(*) FROM warehouse_area_snapshot) areaSnapshots,
      (SELECT COUNT(*) FROM exception_event) exceptionEvents,
      (SELECT COUNT(*) FROM bom_relation) bomRelations,
      (SELECT COUNT(*) FROM kpi_target) kpiTargets
  </select>

  <select id="exportWarehouses" resultType="map">
    SELECT warehouse_id,warehouse_name,warehouse_type,area_count,capacity_locations,warehouse_owner
    FROM warehouse ORDER BY warehouse_id
  </select>
  <select id="exportInventory" resultType="map">
    SELECT warehouse_name,material_code,material_name,project_no,customer_item,project_material_sku,
           product_index_no,glove_size,color_code,main_uom,specification,model,on_hand_main_qty,
           reserved_main_qty,frozen_main_qty,vendor_owned_on_hand_main_qty,stock_date
    FROM inventory_snapshot ORDER BY warehouse_id,project_no,material_code
  </select>
  <select id="exportSkuDaily" resultType="map">
    SELECT * FROM sku_daily_metric ORDER BY biz_date,warehouse_id,project_no,material_code
  </select>
  <select id="exportWarehouseDaily" resultType="map">
    SELECT * FROM warehouse_daily_metric ORDER BY biz_date,warehouse_id
  </select>
  <select id="exportAreaSnapshots" resultType="map">
    SELECT * FROM warehouse_area_snapshot ORDER BY snapshot_date,warehouse_id,area_id
  </select>
  <select id="exportExceptions" resultType="map">
    SELECT * FROM exception_event ORDER BY event_time,event_id
  </select>
  <select id="exportBom" resultType="map">
    SELECT * FROM bom_relation ORDER BY project_no,finished_material_code,component_material_code
  </select>
  <select id="exportTargets" resultType="map">
    SELECT * FROM kpi_target ORDER BY kpi_name
  </select>

  <select id="exportInventoryAgeRules" resultType="map">
    SELECT * FROM inventory_age_rule ORDER BY rule_type,rule_name
  </select>
  <select id="exportInventoryAgeBatches" resultType="map">
    SELECT * FROM inventory_age_batch ORDER BY snapshot_date,warehouse_id,project_no,material_code,age_batch_id
  </select>
  <select id="exportInventoryAgeSkus" resultType="map">
    SELECT * FROM inventory_age_sku ORDER BY snapshot_date,warehouse_id,project_no,material_code
  </select>

  <delete id="deleteWarehouseDaily">
    DELETE FROM warehouse_daily_metric WHERE biz_date = #{bizDate} AND warehouse_id = #{warehouseId}
  </delete>
  <delete id="clearExceptionEvents">DELETE FROM exception_event</delete>
  <delete id="clearAreaSnapshots">DELETE FROM warehouse_area_snapshot</delete>
  <delete id="clearWarehouseDaily">DELETE FROM warehouse_daily_metric</delete>
  <delete id="clearSkuDaily">DELETE FROM sku_daily_metric</delete>
  <delete id="clearInventory">DELETE FROM inventory_snapshot</delete>
  <delete id="clearBom">DELETE FROM bom_relation</delete>
  <delete id="clearTargets">DELETE FROM kpi_target</delete>
  <delete id="clearInventoryAgeBatches">DELETE FROM inventory_age_batch</delete>
  <delete id="clearInventoryAgeSkus">DELETE FROM inventory_age_sku</delete>
  <delete id="clearInventoryAgeRules">DELETE FROM inventory_age_rule</delete>
  <delete id="clearWarehouses">DELETE FROM warehouse</delete>

  <insert id="insertWarehouses">
    INSERT INTO warehouse
      (warehouse_id,warehouse_name,warehouse_type,warehouse_role,area_count,capacity_locations,warehouse_owner)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]})
  </insert>

  <insert id="insertInventory">
    INSERT INTO inventory_snapshot
      (warehouse_id,material_code,project_no,stock_date,warehouse_name,material_name,customer_item,
       project_material_sku,product_index_no,glove_size,color_code,main_uom,specification,model,
       on_hand_main_qty,reserved_main_qty,frozen_main_qty,vendor_owned_on_hand_main_qty)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},#{row[17]})
  </insert>

  <insert id="insertSkuDaily">
    INSERT INTO sku_daily_metric
      (biz_date,warehouse_id,warehouse_name,warehouse_type,warehouse_role,project_no,project_name,
       material_code,material_name,project_material_sku,warehouse_sku_key,material_category,color,model,
       uom,packaging_level,area_id,area_name,inbound_order_count,inbound_line_count,inbound_qty,
       outbound_order_count,outbound_line_count,outbound_qty,picking_task_count,forklift_task_count,
       inventory_accuracy,receipt_timely_rate,delivery_timely_rate,avg_receipt_minutes,
       avg_picking_minutes,exception_count,avg_outbound_lead_days)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},
       #{row[17]},#{row[18]},#{row[19]},#{row[20]},#{row[21]},#{row[22]},#{row[23]},#{row[24]},
       #{row[25]},#{row[26]},#{row[27]},#{row[28]},#{row[29]},#{row[30]},#{row[31]},#{row[32]})
  </insert>

  <insert id="insertWarehouseDaily">
    INSERT INTO warehouse_daily_metric
      (biz_date,warehouse_id,warehouse_name,warehouse_type,inbound_order_count,outbound_order_count,
       raw_inbound_ton,raw_outbound_ton,finished_inbound_carton,finished_outbound_carton,
       packaging_inbound_piece,packaging_outbound_piece,picking_task_count,forklift_task_count,
       inventory_accuracy,receipt_timely_rate,delivery_timely_rate,exception_count,
       avg_receipt_minutes,avg_picking_minutes,dock_utilization_rate,overtime_hours)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},
       #{row[17]},#{row[18]},#{row[19]},#{row[20]},#{row[21]})
  </insert>

  <insert id="insertAreaSnapshots">
    INSERT INTO warehouse_area_snapshot
      (snapshot_date,warehouse_id,warehouse_name,warehouse_type,area_id,area_name,capacity_locations,
       occupied_locations,available_locations,occupancy_rate,material_type_count,abnormal_location_count,
       frozen_qty,area_owner,status)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]})
  </insert>

  <insert id="insertExceptions">
    INSERT INTO exception_event
      (event_id,event_time,event_type,warehouse_id,warehouse_name,warehouse_type,project_no,project_name,
       material_code,material_name,project_material_sku,material_category,color,model,uom,packaging_level,
       area_id,area_name,severity,handling_status,owner,response_minutes,sla_hours,deadline_time,close_time,
       duration_minutes,is_sla_breached,root_cause,action_taken,remark)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},
       #{row[17]},#{row[18]},#{row[19]},#{row[20]},#{row[21]},#{row[22]},#{row[23]},#{row[24]},
       #{row[25]},#{row[26]},#{row[27]},#{row[28]},#{row[29]})
  </insert>

  <insert id="insertBom">
    INSERT INTO bom_relation
      (project_no,project_name,finished_material_code,finished_material_name,finished_color,finished_model,
       finished_uom,component_category,component_material_code,component_material_name,component_color,
       component_model,component_uom,component_qty_per_finished_carton,component_qty_uom,bom_relationship)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]})
  </insert>

  <insert id="insertTargets">
    INSERT INTO kpi_target (kpi_name,target_value,unit,warning_rule,calculation_definition,data_source)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]})
  </insert>

  <insert id="insertInventoryAgeRules">
    INSERT INTO inventory_age_rule
      (rule_type,rule_name,rule_condition,result_level,action_guidance,applicable_scope)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]})
  </insert>

  <insert id="insertInventoryAgeBatches">
    INSERT INTO inventory_age_batch
      (snapshot_date,age_batch_id,warehouse_id,warehouse_name,warehouse_type,project_no,project_name,
       material_code,material_name,project_material_sku,material_category,color,model,uom,batch_no,
       receipt_date,age_days,age_bucket,batch_on_hand_qty,batch_reserved_qty,batch_frozen_qty,
       available_qty,unit_cost,inventory_amount,last_outbound_date,days_since_last_outbound,
       outbound_qty_30d,outbound_rate_30d,coverage_days,movement_status,stagnant_level,is_stagnant,
       stagnant_score,priority,recommended_action,owner,data_source)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},
       #{row[17]},#{row[18]},#{row[19]},#{row[20]},#{row[21]},#{row[22]},#{row[23]},#{row[24]},
       #{row[25]},#{row[26]},#{row[27]},#{row[28]},#{row[29]},#{row[30]},#{row[31]},#{row[32]},
       #{row[33]},#{row[34]},#{row[35]},#{row[36]})
  </insert>

  <insert id="insertInventoryAgeSkus">
    INSERT INTO inventory_age_sku
      (snapshot_date,warehouse_id,warehouse_name,warehouse_type,project_no,project_name,material_code,
       material_name,project_material_sku,material_category,color,model,uom,batch_count,on_hand_qty,
       available_qty,inventory_amount,weighted_avg_age_days,max_age_days,dominant_age_bucket,
       outbound_qty_30d,outbound_rate_30d,latest_sku_outbound_date,days_since_last_sku_outbound,
       stagnant_batch_count,stagnant_inventory_amount,stagnation_ratio,stagnant_level,is_stagnant,
       stagnant_score,priority,recommended_action,owner)
    VALUES
      (#{row[0]},#{row[1]},#{row[2]},#{row[3]},#{row[4]},#{row[5]},#{row[6]},#{row[7]},#{row[8]},
       #{row[9]},#{row[10]},#{row[11]},#{row[12]},#{row[13]},#{row[14]},#{row[15]},#{row[16]},
       #{row[17]},#{row[18]},#{row[19]},#{row[20]},#{row[21]},#{row[22]},#{row[23]},#{row[24]},
       #{row[25]},#{row[26]},#{row[27]},#{row[28]},#{row[29]},#{row[30]},#{row[31]},#{row[32]})
  </insert>

  <insert id="insertImportJob">
    INSERT INTO data_import_job
      (import_id,file_name,import_type,imported_rows,started_at,finished_at,status,message)
    VALUES
      (#{id},#{fileName},#{type},#{rows},#{startedAt},#{finishedAt},#{status},#{message})
  </insert>
</mapper>
